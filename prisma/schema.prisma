model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @db.Timestamptz(3)
  image         String?

  accounts Account[]
  sessions Session[]
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime @db.Timestamptz(3)

  @@unique([identifier, token])
}

// ─── Mirror tabulky (Coda → PostgreSQL) ──────────────────────────────────────

model MirrorSeznamOsob {
  codaRowId     String    @id @map("coda_row_id")
  codaCreatedAt DateTime? @map("coda_created_at") @db.Timestamptz(3)
  codaUpdatedAt DateTime? @map("coda_updated_at") @db.Timestamptz(3)
  syncedAt      DateTime  @default(now()) @map("synced_at") @db.Timestamptz(3)
  data          Json

  @@map("mirror_seznam_osob")
}

model MirrorOsobniLodicky {
  codaRowId     String    @id @map("coda_row_id")
  codaCreatedAt DateTime? @map("coda_created_at") @db.Timestamptz(3)
  codaUpdatedAt DateTime? @map("coda_updated_at") @db.Timestamptz(3)
  syncedAt      DateTime  @default(now()) @map("synced_at") @db.Timestamptz(3)
  data          Json

  @@map("mirror_osobni_lodicky")
}

model MirrorLodickyPoPlavbach {
  codaRowId     String    @id @map("coda_row_id")
  codaCreatedAt DateTime? @map("coda_created_at") @db.Timestamptz(3)
  codaUpdatedAt DateTime? @map("coda_updated_at") @db.Timestamptz(3)
  syncedAt      DateTime  @default(now()) @map("synced_at") @db.Timestamptz(3)
  data          Json

  @@map("mirror_lodicky_po_plavbach")
}

model MirrorHodnoceniPredmetu {
  codaRowId     String    @id @map("coda_row_id")
  codaCreatedAt DateTime? @map("coda_created_at") @db.Timestamptz(3)
  codaUpdatedAt DateTime? @map("coda_updated_at") @db.Timestamptz(3)
  syncedAt      DateTime  @default(now()) @map("synced_at") @db.Timestamptz(3)
  data          Json

  @@map("mirror_hodnoceni_predmetu")
}

model MirrorHodnoceniOblasti {
  codaRowId     String    @id @map("coda_row_id")
  codaCreatedAt DateTime? @map("coda_created_at") @db.Timestamptz(3)
  codaUpdatedAt DateTime? @map("coda_updated_at") @db.Timestamptz(3)
  syncedAt      DateTime  @default(now()) @map("synced_at") @db.Timestamptz(3)
  data          Json

  @@map("mirror_hodnoceni_oblasti")
}

model MirrorKrivka {
  codaRowId     String    @id @map("coda_row_id")
  codaCreatedAt DateTime? @map("coda_created_at") @db.Timestamptz(3)
  codaUpdatedAt DateTime? @map("coda_updated_at") @db.Timestamptz(3)
  syncedAt      DateTime  @default(now()) @map("synced_at") @db.Timestamptz(3)
  data          Json

  @@map("mirror_krivka")
}

model CodaSyncLog {
  tableId      String    @id @map("table_id")
  tableName    String    @map("table_name")
  lastSyncedAt DateTime? @map("last_synced_at") @db.Timestamptz(3)
  rowsSynced   Int       @default(0) @map("rows_synced")
  durationMs   Int?      @map("duration_ms")
  lastError    String?   @map("last_error")
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("coda_sync_log")
}

model AppPerson {
  id                 String    @id @default(cuid())
  dedupKey           String    @unique @map("dedup_key")
  displayName        String    @map("display_name")
  nickname           String?
  chipUid            String?   @map("chip_uid")
  chipHid            String?   @map("chip_hid")
  photo              String?
  firstName          String?   @map("first_name")
  middleName         String?   @map("middle_name")
  lastName           String?   @map("last_name")
  identifier         String?
  plus4uId           String?   @map("plus4u_id")
  isActive           Boolean   @default(true) @map("is_active")
  mergedIntoPersonId String?   @map("merged_into_person_id")
  mergedAt           DateTime? @map("merged_at")
  mergedBy           String?   @map("merged_by")
  mergeReason        String?   @map("merge_reason")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sourceRecords           AppPersonSourceRecord[]
  loginLinks              AppLoginPersonLink[]
  roles                   AppRoleAssignment[]
  parentLinks             AppPersonRelation[]      @relation("ParentPerson")
  childLinks              AppPersonRelation[]      @relation("ChildPerson")
  studentStates           AppStudentState[]
  memberships             AppGroupMembership[]
  violations              AppMembershipViolation[]
  photoFile               AppPersonPhoto?
  m01PredmetyGarant       M01Predmet[]             @relation("M01PredmetGarant")
  m01PodpredmetyGarant    M01Podpredmet[]          @relation("M01PodpredmetGarant")
  m01LodickyGarant        M01Lodicka[]             @relation("M01LodickaGarant")
  m01LodickaGarantLinks   M01LodickaGarant[]
  m01OblastSpravceLinks   M01OblastSpravce[]
  m01LodickaStavGaranti   M01LodickaStavGarant[]
  m01SadyLodicek          M01OsobniSadaLodicek[]   @relation("M01SadaZaka")
  m01EventChanges         M01OsobniLodickaEvent[]  @relation("M01EventChangedBy")
  m01EventSourceCreated   M01OsobniLodickaEvent[]  @relation("M01EventSourceCreatedBy")
  m01EventSourceModified  M01OsobniLodickaEvent[]  @relation("M01EventSourceModifiedBy")
  m01ApprovedSvpVersions  M01SvpVersion[]          @relation("M01SvpVersionApprovedBy")
  m01SvpVersionChanges    M01SvpVersionChange[]    @relation("M01SvpVersionChangedBy")
  m01ApprovedMigracePlans M01SvpMigracePlan[]      @relation("M01MigracePlanApprovedBy")
  notesAuthored           AppNote[]                @relation("AppNoteAuthor")
  studentCalendars        AppStudentCalendar[]
  schoolEventsCreated     AppSchoolEvent[]         @relation("AppSchoolEventCreatedBy")
  schoolEventsUpdated     AppSchoolEvent[]         @relation("AppSchoolEventUpdatedBy")
  schoolEventTargets      AppSchoolEventTarget[]
  mergedIntoPerson        AppPerson?               @relation("MergedPersons", fields: [mergedIntoPersonId], references: [id], onDelete: SetNull)
  mergedPersons           AppPerson[]              @relation("MergedPersons")

  @@index([mergedIntoPersonId], map: "app_person_merged_into_person_id_idx")
  @@index([identifier], map: "app_person_identifier_idx")
  @@index([plus4uId], map: "app_person_plus4u_id_idx")
  @@index([chipUid], map: "app_person_chip_uid_idx")
  @@index([chipHid], map: "app_person_chip_hid_idx")
  @@map("app_person")
}

model AppPersonPhoto {
  personId   String   @id @map("person_id")
  mimeType   String   @map("mime_type")
  content    Bytes
  sizeBytes  Int      @map("size_bytes")
  sourceUrl  String?  @map("source_url")
  sourceHash String?  @map("source_hash")
  fetchedAt  DateTime @default(now()) @map("fetched_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  person AppPerson @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([sourceHash], map: "app_person_photo_source_hash_idx")
  @@map("app_person_photo")
}

model AppPersonSourceRecord {
  id                String   @id @default(cuid())
  personId          String   @map("person_id")
  sourceType        String   @map("source_type")
  sourceKey         String   @unique @map("source_key")
  sourcePersonId    String?  @map("source_person_id")
  sourceRecordId    String?  @map("source_record_id")
  organizationIdent String?  @map("organization_ident")
  primaryEmail      String?  @map("primary_email")
  activeSource      Boolean  @default(true) @map("active_source")
  derivedRoles      String[] @default([]) @map("derived_roles")
  payload           Json
  sourceHash        String?  @map("source_hash")
  syncedAt          DateTime @default(now()) @map("synced_at") @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  person AppPerson @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId], map: "app_person_source_record_person_id_idx")
  @@index([sourceType], map: "app_person_source_record_source_type_idx")
  @@index([sourcePersonId], map: "app_person_source_record_source_person_id_idx")
  @@map("app_person_source_record")
}

model AppLoginIdentity {
  id              String   @id @default(cuid())
  identityType    String   @default("email") @map("identity_type")
  identityValue   String   @map("identity_value")
  normalizedValue String   @map("normalized_value")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  personLinks AppLoginPersonLink[]
  conflicts   AppIdentityConflict[]

  @@unique([identityType, normalizedValue], map: "app_login_identity_type_normalized_value_key")
  @@index([normalizedValue], map: "app_login_identity_normalized_value_idx")
  @@map("app_login_identity")
}

model AppLoginPersonLink {
  id         String    @id @default(cuid())
  identityId String    @map("identity_id")
  personId   String    @map("person_id")
  status     String    @default("pending")
  approvedBy String?   @map("approved_by")
  approvedAt DateTime? @map("approved_at") @db.Timestamptz(3)
  reason     String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  identity AppLoginIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  person   AppPerson        @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([identityId, personId], map: "app_login_person_link_identity_id_person_id_key")
  // DB migration 20260507090000_single_approved_login_owner adds a partial unique
  // index on identityId for rows where status = 'approved'. Prisma cannot express
  // that partial index in schema.prisma.
  @@index([personId], map: "app_login_person_link_person_id_idx")
  @@index([status], map: "app_login_person_link_status_idx")
  @@map("app_login_person_link")
}

model AppRoleAssignment {
  id        String    @id @default(cuid())
  personId  String    @map("person_id")
  role      String
  source    String    @default("auto")
  isActive  Boolean   @default(true) @map("is_active")
  validFrom DateTime? @map("valid_from") @db.Timestamptz(3)
  validTo   DateTime? @map("valid_to") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  person AppPerson @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, role, source], map: "app_role_assignment_person_id_role_source_key")
  @@index([role], map: "app_role_assignment_role_idx")
  @@index([source], map: "app_role_assignment_source_idx")
  @@map("app_role_assignment")
}

model AppPersonRelation {
  id             String   @id @default(cuid())
  parentPersonId String   @map("parent_person_id")
  childPersonId  String   @map("child_person_id")
  relationType   String   @default("parent_of") @map("relation_type")
  source         String   @default("auto")
  isActive       Boolean  @default(true) @map("is_active")
  createdBy      String?  @map("created_by")
  updatedBy      String?  @map("updated_by")
  changeReason   String?  @map("change_reason")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  parentPerson AppPerson @relation("ParentPerson", fields: [parentPersonId], references: [id], onDelete: Cascade)
  childPerson  AppPerson @relation("ChildPerson", fields: [childPersonId], references: [id], onDelete: Cascade)

  @@unique([parentPersonId, childPersonId, relationType, source], map: "app_person_relation_parent_child_relation_source_key")
  @@index([parentPersonId], map: "app_person_relation_parent_person_id_idx")
  @@index([childPersonId], map: "app_person_relation_child_person_id_idx")
  @@index([source], map: "app_person_relation_source_idx")
  @@map("app_person_relation")
}

model AppIdentityConflict {
  id              String    @id @default(cuid())
  identityId      String?   @map("identity_id")
  normalizedValue String    @map("normalized_value")
  status          String    @default("open")
  reason          String
  details         Json?
  resolvedBy      String?   @map("resolved_by")
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  identity AppLoginIdentity? @relation(fields: [identityId], references: [id], onDelete: SetNull)

  @@index([status], map: "app_identity_conflict_status_idx")
  @@index([normalizedValue], map: "app_identity_conflict_normalized_value_idx")
  @@map("app_identity_conflict")
}

model AppUserSyncRun {
  id                   String    @id @default(cuid())
  source               String
  runType              String    @map("run_type")
  requestedDate        String?   @map("requested_date")
  includeInactiveSince String?   @map("include_inactive_since")
  status               String    @default("running")
  studentsCount        Int       @default(0) @map("students_count")
  employeesCount       Int       @default(0) @map("employees_count")
  csvCount             Int       @default(0) @map("csv_count")
  personsTouched       Int       @default(0) @map("persons_touched")
  error                String?
  startedAt            DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt           DateTime? @map("finished_at") @db.Timestamptz(3)

  studentStatesChanged AppStudentState[] @relation("SyncRunStudentState")

  @@index([source], map: "app_user_sync_run_source_idx")
  @@index([status], map: "app_user_sync_run_status_idx")
  @@map("app_user_sync_run")
}

model M01RvpVersion {
  id             String   @id @default(cuid())
  sourceUrl      String   @map("source_url")
  sourceFormat   String   @default("full_mp") @map("source_format")
  datasetVersion String   @map("dataset_version")
  sourceHash     String?  @map("source_hash")
  importedAt     DateTime @default(now()) @map("imported_at") @db.Timestamptz(3)
  importedBy     String?  @map("imported_by")
  isActive       Boolean  @default(false) @map("is_active")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  uzloveBody  M01RvpUzlovyBod[]
  ovu         M01RvpOvu[]
  svpVersions M01SvpVersion[]

  @@unique([datasetVersion, sourceFormat], map: "app_m01_rvp_version_dataset_format_key")
  @@index([isActive], map: "app_m01_rvp_version_is_active_idx")
  @@map("app_m01_rvp_version")
}

model M01RvpUzlovyBod {
  id           String   @id @default(cuid())
  rvpVersionId String   @map("rvp_version_id")
  kod          String
  nazev        String
  gradeNum     Int?     @map("grade_num")
  stageCode    String?  @map("stage_code")
  sourcePath   String   @map("source_path")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  rvpVersion M01RvpVersion @relation(fields: [rvpVersionId], references: [id], onDelete: Cascade)
  ovu        M01RvpOvu[]

  @@unique([rvpVersionId, sourcePath], map: "app_m01_rvp_uzlovy_bod_version_path_key")
  @@index([kod], map: "app_m01_rvp_uzlovy_bod_kod_idx")
  @@map("app_m01_rvp_uzlovy_bod")
}

model M01RvpOvu {
  id                String   @id @default(cuid())
  rvpVersionId      String   @map("rvp_version_id")
  uzlovyBodId       String?  @map("uzlovy_bod_id")
  kod               String
  zneni             String
  popisAZduvodneni  String?  @map("popis_a_zduvodneni")
  hodnoty           Json?
  predchazejiciKody String[] @default([]) @map("predchazejici_kody")
  souvisejiciKody   String[] @default([]) @map("souvisejici_kody")
  nasledujiciKody   String[] @default([]) @map("nasledujici_kody")
  metodickaPodpora  Json?    @map("metodicka_podpora")
  sourceBranch      String?  @map("source_branch")
  sourcePath        String?  @map("source_path")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  rvpVersion   M01RvpVersion       @relation(fields: [rvpVersionId], references: [id], onDelete: Cascade)
  uzlovyBod    M01RvpUzlovyBod?    @relation(fields: [uzlovyBodId], references: [id], onDelete: SetNull)
  lodickaLinks M01LodickaOvuLink[]

  @@unique([rvpVersionId, kod], map: "app_m01_rvp_ovu_version_kod_key")
  @@index([kod], map: "app_m01_rvp_ovu_kod_idx")
  @@index([uzlovyBodId], map: "app_m01_rvp_ovu_uzlovy_bod_id_idx")
  @@map("app_m01_rvp_ovu")
}

model M01SvpVersion {
  id                  String              @id @default(cuid())
  label               String
  versionLabel        String              @default("1") @map("version_label")
  major               Int
  minor               Int
  patch               Int                 @default(0)
  zmenaType           M01SvpZmenaType     @map("zmena_type")
  status              M01SvpVersionStatus @default(DRAFT)
  basedOnRvpVersionId String              @map("based_on_rvp_version_id")
  parentSvpVersionId  String?             @map("parent_svp_version_id")
  effectiveFrom       DateTime            @map("effective_from") @db.Timestamptz(3)
  effectiveTo         DateTime?           @map("effective_to") @db.Timestamptz(3)
  approvedAt          DateTime?           @map("approved_at") @db.Timestamptz(3)
  approvedByPersonId  String?             @map("approved_by_person_id")
  isCurrent           Boolean             @default(false) @map("is_current")
  notes               String?
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

